# Django Configuration
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration (PostgreSQL 18.x)
DATABASE_URL=postgres://tci_user:tci_password@postgres:5432/tci_hlc_finance

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# System Administrator Initial & Recovery Credentials (Protected Secrets)
SYSTEM_ADMIN_EMAIL=admin@tcihlc.org
SYSTEM_ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin123!
SYSTEM_ADMIN_RECOVERY_EMAIL=admin.recovery@tcihlc.org
SYSTEM_ADMIN_RECOVERY_PHONE=+233200000001

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_DIR=/var/app/media

# Security & Session Settings
SESSION_COOKIE_AGE=1800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
